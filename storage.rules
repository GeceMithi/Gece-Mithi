rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access and write access for home slide images
    match /home-slides/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Allow authenticated users to read/write other files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}